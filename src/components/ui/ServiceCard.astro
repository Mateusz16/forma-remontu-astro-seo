---
import { Image } from "astro:assets";
import type { Service } from "@/data/site";
interface Props { service: Service; index?: number }
const { service, index = 0 } = Astro.props;
---

<article class="service-card">
  <a class="service-card__image" href={`/oferta/${service.slug}/`} tabindex="-1" aria-hidden="true">
    <Image src={service.image} alt="" widths={[480, 720]} sizes="(max-width: 720px) 100vw, 33vw" loading="lazy" />
    <span>{String(index + 1).padStart(2, "0")}</span>
  </a>
  <div class="service-card__body">
    <p>{service.eyebrow}</p>
    <h3><a href={`/oferta/${service.slug}/`}>{service.navLabel}</a></h3>
    <span aria-hidden="true">↗</span>
  </div>
</article>

<style>
  .service-card { min-width: 0; height: 100%; display: grid; grid-template-rows: auto 1fr; }
  .service-card__image { position: relative; display: block; overflow: hidden; background: var(--sage-100); aspect-ratio: 4 / 3; }
  .service-card__image :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms var(--ease-out); }
  .service-card:hover .service-card__image :global(img) { transform: scale(1.035); }
  .service-card__image > span { position: absolute; left: var(--space-4); bottom: var(--space-4); display: grid; place-items: center; width: 2.6rem; aspect-ratio: 1; color: var(--forest-950); background: var(--lime); font-size: var(--text-xs); font-weight: 850; }
  .service-card__body { position: relative; min-height: 7.4rem; padding: var(--space-5) 3rem var(--space-4) 0; display: flex; flex-direction: column; border-bottom: 1px solid var(--line-strong); }
  .service-card__body p { margin: 0 0 var(--space-2); color: var(--muted); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .service-card__body h3 { margin: auto 0 0; font-size: var(--text-lg); line-height: 1.16; }
  .service-card__body > span { position: absolute; right: 0; bottom: var(--space-5); color: var(--clay); font-size: 1.2rem; }
</style>
