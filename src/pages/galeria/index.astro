---
import { Image } from "astro:assets";
import ContactBand from "@/components/sections/ContactBand.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import { galleryGroups } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Wizualizacje realizacji | Forma Remontu";
const description = "Galeria neutralnych placeholderów prezentujących układ koncepcyjnej strony dla fikcyjnej firmy remontowej.";
const breadcrumbs = [{ name: "Strona główna", path: "/" }, { name: "Realizacje", path: "/galeria/" }];
---

<BaseLayout title={title} description={description} path="/galeria/" breadcrumbs={breadcrumbs}>
  <Breadcrumbs items={breadcrumbs} />
  <section class="gallery-head section-pad--compact">
    <div class="container gallery-head__grid">
      <div><p class="eyebrow">Placeholdery zdjęć</p><h1>Zobacz docelowy układ galerii.</h1></div>
      <p class="lede">Jeden spójny placeholder wyznacza miejsca na przyszłe fotografie i nie dokumentuje prac żadnej istniejącej firmy.</p>
    </div>
  </section>

  <section class="gallery-list section-pad surface-sage">
    <div class="container gallery-list__grid">
      {galleryGroups.map((group, index) => (
        <article class:list={["gallery-card", index === 0 && "gallery-card--large"]}>
          <a href={`/galeria/${group.slug}/`} tabindex="-1" aria-hidden="true"><Image src={group.images[0]} alt="" widths={[600, 900, 1200]} sizes="(max-width: 760px) 100vw, 50vw" /></a>
          <div><span>{String(index + 1).padStart(2, "0")}</span><h2><a href={`/galeria/${group.slug}/`}>{group.title}</a></h2><p>{group.description}</p><a class="text-link" href={`/galeria/${group.slug}/`}>Zobacz galerię <b aria-hidden="true">↗</b></a></div>
        </article>
      ))}
    </div>
  </section>
  <ContactBand heading="Chcesz omówić podobny zakres prac?" />
</BaseLayout>

<style>
  .gallery-head__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--space-10); align-items: end; }
  h1 { max-width: 12ch; margin: 0; font-size: var(--text-4xl); line-height: 0.95; }
  .gallery-list__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8) var(--space-5); }
  .gallery-card > a { display: block; aspect-ratio: 16 / 10; overflow: hidden; }
  .gallery-card > a :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms var(--ease-out); }
  .gallery-card:hover > a :global(img) { transform: scale(1.025); }
  .gallery-card > div { padding: var(--space-5) 0; display: grid; grid-template-columns: 3rem 1fr; column-gap: var(--space-4); border-bottom: 1px solid var(--line-strong); }
  .gallery-card > div > span { color: var(--clay); font-size: var(--text-xs); font-weight: 850; }
  .gallery-card h2 { margin: 0; font-size: var(--text-2xl); line-height: 1.05; }
  .gallery-card p, .gallery-card .text-link { grid-column: 2; }
  .gallery-card p { margin: var(--space-3) 0 var(--space-5); color: var(--muted); }
  .gallery-card b { color: var(--clay); }
  @media (max-width: 760px) { .gallery-head__grid, .gallery-list__grid { grid-template-columns: 1fr; } }
</style>
