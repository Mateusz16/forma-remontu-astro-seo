---
import { Image } from "astro:assets";
import ContactBand from "@/components/sections/ContactBand.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import { galleryGroups, getService } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return galleryGroups.map((gallery) => ({ params: { slug: gallery.slug }, props: { gallery } }));
}

type Gallery = (typeof galleryGroups)[number];
interface Props { gallery: Gallery }
const { gallery } = Astro.props;
const path = `/galeria/${gallery.slug}/`;
const related = getService(gallery.relatedService);
const title = `${gallery.title} | Galeria demo Forma Remontu`;
const breadcrumbs = [
  { name: "Strona główna", path: "/" },
  { name: "Realizacje", path: "/galeria/" },
  { name: gallery.title, path },
];
---

<BaseLayout title={title} description={gallery.description} path={path} breadcrumbs={breadcrumbs}>
  <Breadcrumbs items={breadcrumbs} />
  <section class="gallery-detail section-pad--compact">
    <div class="container gallery-detail__head">
      <div><p class="eyebrow">Placeholdery realizacji</p><h1>{gallery.title}</h1></div>
      <div><p class="lede">{gallery.description}</p>{related && <a class="text-link" href={`/oferta/${related.slug}/`}>Przejdź do usługi <span aria-hidden="true">↗</span></a>}</div>
    </div>
    <div class="container gallery-detail__grid">
      {gallery.images.map((image, index) => (
        <figure class:list={[index === 0 && "gallery-detail__lead"]}>
          <Image src={image} alt={`Miejsce na zdjęcie realizacji: ${gallery.title}`} widths={[600, 900, 1400]} sizes="(max-width: 760px) 100vw, 50vw" />
          <figcaption><span>{String(index + 1).padStart(2, "0")}</span>{gallery.captions[index]}</figcaption>
        </figure>
      ))}
    </div>
  </section>
  <ContactBand heading="Porozmawiajmy o podobnym zakresie." />
</BaseLayout>

<style>
  .gallery-detail__head { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--space-10); align-items: end; margin-bottom: var(--space-10); }
  h1 { max-width: 13ch; margin: 0; font-size: var(--text-4xl); line-height: 0.95; }
  .gallery-detail__head .text-link { margin-top: var(--space-4); }
  .gallery-detail__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); }
  figure { margin: 0; }
  figure :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .gallery-detail__lead { grid-column: 1 / -1; }
  .gallery-detail__lead :global(img) { aspect-ratio: 16 / 8; }
  figcaption { padding: var(--space-3) 0; display: grid; grid-template-columns: 3rem 1fr; color: var(--muted); font-size: var(--text-sm); border-bottom: 1px solid var(--line); }
  figcaption span { color: var(--clay); font-size: var(--text-xs); font-weight: 850; }
  @media (max-width: 760px) { .gallery-detail__head, .gallery-detail__grid { grid-template-columns: 1fr; } .gallery-detail__lead { grid-column: auto; } .gallery-detail__lead :global(img) { aspect-ratio: 4 / 3; } }
</style>
