---
import { Image } from "astro:assets";
import ContactBand from "@/components/sections/ContactBand.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import projectPlaceholder from "@/assets/project-photo-placeholder.svg";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "O koncepcji | Forma Remontu";
const description = "Poznaj założenia fikcyjnej marki Forma Remontu i demonstracyjny sposób prezentacji lokalnych usług remontowych.";
const breadcrumbs = [{ name: "Strona główna", path: "/" }, { name: "O nas", path: "/o-nas/" }];
---

<BaseLayout title={title} description={description} path="/o-nas/" breadcrumbs={breadcrumbs}>
  <Breadcrumbs items={breadcrumbs} />
  <section class="about-hero section-pad--compact">
    <div class="container about-hero__grid">
      <div>
        <p class="eyebrow">Forma Remontu · koncept</p>
        <h1>Jasny sposób prezentacji lokalnych usług.</h1>
      </div>
      <p class="lede">To fikcyjna marka pokazująca, jak można połączyć remonty, serwis okien, czyszczenie powierzchni i prace zewnętrzne w jednym czytelnym serwisie.</p>
    </div>
    <div class="container about-hero__image"><Image src={projectPlaceholder} alt="Miejsce na zdjęcie realizacji" widths={[900, 1440, 1800]} sizes="100vw" loading="eager" /></div>
  </section>

  <section class="about-copy section-pad surface-sage">
    <div class="container about-copy__grid">
      <div>
        <p class="eyebrow">Architektura treści</p>
        <h2>Oferta uporządkowana według realnych potrzeb.</h2>
        <p class="about-copy__intro">Koncepcja pokazuje kilka specjalizacji w osobnych, łatwych do porównania ścieżkach zamiast umieszczać całą ofertę na jednej przeładowanej stronie.</p>
      </div>
      <div class="history" aria-label="Główne założenia koncepcji">
        <article><span>01</span><div><h3>Szybka orientacja</h3><p>Użytkownik od razu widzi obszar usług i może przejść do interesującego go zakresu.</p></div></article>
        <article><span>02</span><div><h3>Konkretny opis usługi</h3><p>Każda podstrona wyjaśnia problem, zakres, rezultat i informacje potrzebne do rozmowy.</p></div></article>
        <article><span>03</span><div><h3>Mobilny kontakt</h3><p>Układ jest przygotowany pod szybką akcję na telefonie, bez rozbudowanych formularzy.</p></div></article>
      </div>
    </div>
  </section>

  <section class="principles section-pad">
    <div class="container principles__grid">
      <Image src={projectPlaceholder} alt="Miejsce na zdjęcie realizacji" widths={[600, 900]} sizes="(max-width: 800px) 100vw, 42vw" />
      <div>
        <p class="eyebrow">Sposób pracy</p>
        <h2>Najpierw warunki na miejscu. Potem konkretny zakres.</h2>
        <ul>
          <li><span>01</span><div><h3>Rozpoznanie</h3><p>Materiał, stan powierzchni, dostęp i oczekiwany efekt wpływają na sposób realizacji.</p></div></li>
          <li><span>02</span><div><h3>Przygotowanie</h3><p>Czyszczenie, zabezpieczenie otoczenia i naprawa podłoża często decydują o trwałości pracy.</p></div></li>
          <li><span>03</span><div><h3>Właściwe narzędzia</h3><p>Firma korzysta z elektronarzędzi i sprzętu dobieranego do konkretnego zadania, także przy pracach na wysokości.</p></div></li>
          <li><span>04</span><div><h3>Kontakt bez pośredników</h3><p>Krótka rozmowa pozwala szybko ustalić, czy dana usługa odpowiada problemowi.</p></div></li>
        </ul>
      </div>
    </div>
  </section>
  <ContactBand heading="Zacznijmy od krótkiego opisu prac." />
</BaseLayout>

<style>
  .about-hero__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--space-10); align-items: end; margin-bottom: var(--space-10); }
  h1 { max-width: 12ch; margin: 0; font-size: var(--text-4xl); line-height: 0.95; }
  .about-hero__image { max-height: 42rem; overflow: hidden; }
  .about-hero__image :global(img) { width: 100%; height: 42rem; object-fit: cover; object-position: center; }
  .about-copy__grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: var(--space-12); }
  h2 { max-width: 13ch; margin: 0; font-size: var(--text-3xl); line-height: 1.02; }
  .about-copy__intro { max-width: 34rem; margin: var(--space-6) 0 0; color: var(--muted); font-size: var(--text-lg); }
  .history { border-top: 1px solid var(--line-strong); }
  .history article { min-height: 8rem; padding: var(--space-5) 0; display: grid; grid-template-columns: 6rem 1fr; border-bottom: 1px solid var(--line-strong); }
  .history article > span { color: var(--clay); font-size: var(--text-lg); font-weight: 850; }
  .history h3 { margin: 0 0 var(--space-2); font-size: var(--text-xl); }
  .history p { max-width: 40rem; margin: 0; color: var(--muted); }
  .principles__grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: var(--space-12); align-items: center; }
  .principles__grid > :global(img) { width: 100%; min-height: 38rem; object-fit: cover; }
  ul { margin: var(--space-8) 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  li { padding: var(--space-5) 0; display: grid; grid-template-columns: 3.5rem 1fr; border-bottom: 1px solid var(--line-strong); }
  li > span { color: var(--clay); font-size: var(--text-xs); font-weight: 850; }
  li h3 { margin: 0 0 var(--space-2); font-size: var(--text-xl); }
  li p { margin: 0; color: var(--muted); }
  @media (max-width: 800px) { .about-hero__grid, .about-copy__grid, .principles__grid { grid-template-columns: 1fr; } .about-hero__image :global(img) { height: 30rem; } .principles__grid > :global(img) { min-height: 28rem; } }
</style>
