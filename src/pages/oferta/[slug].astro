---
import { Image } from "astro:assets";
import ContactBand from "@/components/sections/ContactBand.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import ServiceCard from "@/components/ui/ServiceCard.astro";
import { company, processSteps, services, type Service } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service } = Astro.props;
const path = `/oferta/${service.slug}/`;
const related = services.filter((item) => item.slug !== service.slug && (item.category === service.category || item.featured)).slice(0, 3);
const breadcrumbs = [
  { name: "Strona główna", path: "/" },
  { name: "Oferta", path: "/#uslugi" },
  { name: service.title, path },
];
const serviceSchema = {
  "@type": "Service",
  name: service.title,
  description: service.description,
  areaServed: { "@type": "City", name: company.city },
  provider: { "@id": `${company.domain}/#demo-brand` },
};
---

<BaseLayout title={service.seoTitle} description={service.description} path={path} breadcrumbs={breadcrumbs} schema={serviceSchema}>
  <Breadcrumbs items={breadcrumbs} />

  <section class="service-hero section-pad--compact">
    <div class="container service-hero__grid">
      <div class="service-hero__copy">
        <p class="eyebrow">{service.eyebrow}</p>
        <h1>{service.title}</h1>
        <p class="lede">{service.intro}</p>
        <div class="service-hero__actions">
          <a class="button" href="/kontakt/">Zobacz kontakt demo</a>
          <a class="text-link" href="#zakres">Co obejmuje usługa <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="service-hero__image">
        <Image src={service.image} alt={`Miejsce na zdjęcie realizacji: ${service.title}`} widths={[720, 1080, 1440]} sizes="(max-width: 800px) 100vw, 48vw" loading="eager" fetchpriority="high" />
        <div><span>Obszar działania</span><strong>{company.area}</strong></div>
      </div>
    </div>
  </section>

  <section class="service-context section-pad" aria-labelledby="context-heading">
    <div class="container service-context__grid">
      <div class="service-context__copy">
        <p class="eyebrow eyebrow--light">Kiedy warto działać</p>
        <h2 id="context-heading">{service.detailTitle}</h2>
        {service.details.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="service-context__signals" aria-labelledby="signals-heading">
        <p>Praktyczna lista</p>
        <h3 id="signals-heading">{service.signalsTitle}</h3>
        <ul>
          {service.signals.map((signal, index) => (
            <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{signal}</strong></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <section class="scope section-pad surface-sage" id="zakres" aria-labelledby="scope-heading">
    <div class="container scope__grid">
      <div>
        <p class="eyebrow">Zakres usługi</p>
        <h2 id="scope-heading">Co możemy wykonać?</h2>
      </div>
      <div class="scope__list">
        {service.scope.map((item, index) => (
          <div><span>{String(index + 1).padStart(2, "0")}</span><p>{item}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="outcomes section-pad" aria-labelledby="outcomes-heading">
    <div class="container outcomes__grid">
      <div>
        <p class="eyebrow">Rezultat prac</p>
        <h2 id="outcomes-heading">Efekt, który można jasno ocenić.</h2>
      </div>
      <div class="outcomes__cards">
        {service.outcomes.map((outcome) => (
          <article><span aria-hidden="true">✓</span><h3>{outcome}</h3></article>
        ))}
      </div>
    </div>
  </section>

  <section class="service-process section-pad surface-cream" aria-labelledby="service-process-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Jak zacząć</p>
          <h2 id="service-process-heading">Cztery czytelne kroki.</h2>
        </div>
        <p>Ostateczny sposób realizacji zależy od powierzchni, dostępu i stanu zastanego. Dlatego pierwsza rozmowa ma znaczenie.</p>
      </div>
      <ol>
        {processSteps.map((step) => (
          <li><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="related section-pad" aria-labelledby="related-heading">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">Powiązane usługi</p><h2 id="related-heading">Może przydać się również.</h2></div>
        <p>Zakresy można omawiać łącznie, jeśli dotyczą tego samego budynku lub etapu prac.</p>
      </div>
      <div class="related__grid">{related.map((item, index) => <ServiceCard service={item} index={index} />)}</div>
    </div>
  </section>

  <ContactBand heading={`Porozmawiajmy o usłudze: ${service.navLabel.toLowerCase()}.`} />
</BaseLayout>

<style>
  .service-hero__grid { display: grid; grid-template-columns: 1fr 0.95fr; gap: clamp(2rem, 6vw, 7rem); align-items: center; }
  .service-hero h1 { max-width: 12ch; margin: 0 0 var(--space-6); font-size: var(--text-4xl); line-height: 0.94; }
  .service-hero__actions { margin-top: var(--space-7); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-6); }
  .service-hero__image { position: relative; min-height: 38rem; }
  .service-hero__image :global(img) { width: 100%; height: 100%; min-height: 38rem; object-fit: cover; }
  .service-hero__image > div { position: absolute; left: -2rem; bottom: 2rem; min-width: 13rem; padding: var(--space-5); display: grid; color: var(--forest-950); background: var(--lime); }
  .service-hero__image span { font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }

  .service-context { color: white; background: var(--forest-950); }
  .service-context__grid { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(2.5rem, 8vw, 9rem); align-items: start; }
  .service-context__copy h2 { max-width: 14ch; margin: 0 0 var(--space-7); color: white; font-size: var(--text-3xl); line-height: 1.02; }
  .service-context__copy > p:not(.eyebrow) { max-width: 42rem; margin-bottom: var(--space-4); color: var(--sage-200); font-size: var(--text-lg); }
  .service-context__signals { padding: var(--space-7); color: var(--ink); background: var(--paper); }
  .service-context__signals > p { margin: 0 0 var(--space-2); color: var(--clay); font-size: var(--text-xs); font-weight: 850; letter-spacing: 0.1em; text-transform: uppercase; }
  .service-context__signals h3 { max-width: 18ch; margin: 0 0 var(--space-6); font-size: var(--text-2xl); line-height: 1.05; }
  .service-context__signals ul { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .service-context__signals li { min-height: 4.5rem; padding: var(--space-3) 0; display: grid; grid-template-columns: 3rem 1fr; align-items: center; border-bottom: 1px solid var(--line-strong); }
  .service-context__signals li span { color: var(--clay); font-size: var(--text-xs); font-weight: 850; }
  .service-context__signals li strong { line-height: 1.3; }

  .scope__grid, .outcomes__grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 7vw, 8rem); }
  .scope h2, .outcomes h2 { max-width: 13ch; margin: 0; font-size: var(--text-3xl); line-height: 1.02; }
  .scope__list { border-top: 1px solid var(--line-strong); }
  .scope__list > div { min-height: 5rem; padding: var(--space-4) 0; display: grid; grid-template-columns: 3.5rem 1fr; align-items: center; border-bottom: 1px solid var(--line-strong); }
  .scope__list span { color: var(--clay); font-size: var(--text-xs); font-weight: 850; }
  .scope__list p { margin: 0; font-size: var(--text-lg); font-weight: 720; }

  .outcomes__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .outcomes__cards article { min-height: 15rem; padding: var(--space-5); display: flex; flex-direction: column; justify-content: space-between; background: var(--forest-950); }
  .outcomes__cards span { display: grid; place-items: center; width: 2.4rem; aspect-ratio: 1; color: var(--forest-950); background: var(--lime); border-radius: 50%; font-weight: 900; }
  .outcomes__cards h3 { margin: var(--space-8) 0 0; color: white; font-size: var(--text-lg); line-height: 1.15; }

  .service-process ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .service-process li { padding: var(--space-5) 0; display: grid; grid-template-columns: 5rem 1fr; border-bottom: 1px solid var(--line-strong); }
  .service-process li > span { color: var(--clay); font-size: var(--text-xs); font-weight: 850; }
  .service-process h3 { margin: 0 0 var(--space-2); font-size: var(--text-xl); }
  .service-process p { max-width: 45rem; margin: 0; color: var(--muted); }
  .related__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }

  @media (max-width: 900px) {
    .service-hero__grid, .service-context__grid, .scope__grid, .outcomes__grid { grid-template-columns: 1fr; }
    .service-hero__image, .service-hero__image :global(img) { min-height: 30rem; }
    .service-hero__image > div { left: 1rem; }
  }
  @media (max-width: 680px) {
    .outcomes__cards, .related__grid { grid-template-columns: 1fr; }
    .outcomes__cards article { min-height: 11rem; }
  }
</style>
